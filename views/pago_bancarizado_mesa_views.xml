<odoo>
<!-- FORM -->

    <record id="view_pago_bancarizado_mesa_list" model="ir.ui.view">
        <field name="name">casino.pago.bancarizado.mesa</field>
        <field name="model">casino.pago.bancarizado.mesa</field>
        <field name="arch" type="xml">
            <list string="Pagos Bancarizados Mesa" editable="bottom">
                <field name="currency_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="cuadre_id" readonly="1" force_save="1" optional="hide"/>
                <field name="partner_id" options="{'no_create': True}" optional="show"/>
                <field name="account_journal_id" options="{'no_open': True, 'no_create': True}" optional="show"/>
                <field name="outbound_payment_method_line_ids" column_invisible="1"/>
                <field name="payment_method_line_id" options="{'no_open': True, 'no_create': True}" optional="show"/>
                <field name="is_check_method" column_invisible="1"/>
                <field name="numero_cheque" optional="show" required="is_check_method"/>
                <field name="amount" sum="Total" optional="show"/>
                <field name="pago_cliente_payment_id" optional="show" readonly="1" force_save="1"/>
                <button name="action_create_pago_cliente" string="Pagar" type="object" class="btn-link"
                        icon="fa-bank" invisible="pago_cliente_payment_id" groups="ttg_casino.group_casino_accountant"/>
                <field name="reposicion_payment_id" optional="show" readonly="1" force_save="1"/>
                <button name="action_create_reposicion" string="Reponer" type="object" class="btn-link"
                        icon="fa-exchange" invisible="not pago_cliente_payment_id or reposicion_payment_id" groups="ttg_casino.group_casino_accountant"/>
                <field name="state" widget="badge" optional="hide" decoration-success="state == 'done'" decoration-info="state == 'audit'" decoration-warning="state == 'accounting'"/>
            </list>
        </field>
    </record>

    <record id="view_pago_bancarizado_mesa_list_readonly" model="ir.ui.view">
        <field name="name">casino.pago.bancarizado.mesa</field>
        <field name="model">casino.pago.bancarizado.mesa</field>
        <field name="arch" type="xml">
            <list string="Pagos Bancarizados Mesa" create="0" edit="0" delete="0">
                <field name="currency_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="cuadre_id" readonly="1" force_save="1" optional="hide"/>
                <field name="partner_id" options="{'no_create': True}" optional="show"/>
                <field name="account_journal_id" options="{'no_open': True, 'no_create': True}" optional="show"/>
                <field name="payment_method_line_id" options="{'no_open': True, 'no_create': True}" optional="show"/>
                <field name="numero_cheque" optional="show"/>
                <field name="amount" sum="Total" optional="show"/>
                <field name="pago_cliente_payment_id" optional="show"/>
                <field name="reposicion_payment_id" optional="show"/>
                <field name="state" widget="badge" optional="hide" decoration-success="state == 'done'" decoration-info="state == 'audit'" decoration-warning="state == 'accounting'"/>
            </list>
        </field>
    </record>

    <record id="pago_bancarizado_mesa_search" model="ir.ui.view">
        <field name="name">casino.pago.bancarizado.mesa.search</field>
        <field name="model">casino.pago.bancarizado.mesa</field>
        <field name="arch" type="xml">
            <search string="Search Pagos Bancarizados Mesa">
                <field name="partner_id"/>
                <field name="account_journal_id"/>

                <group expand="0" string="Group By">
                    <filter string="Cliente" name="partner_id"
                            domain="[]"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Banco" name="account_journal_id"
                            domain="[]"
                            context="{'group_by':'account_journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pago_bancarizado_mesa" model="ir.actions.act_window">
        <field name="name">Pagos Bancarizados Mesa</field>
        <field name="res_model">casino.pago.bancarizado.mesa</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pago_bancarizado_mesa_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Detalles de Pagos Bancarizados Mesa.
            </p>
        </field>
    </record>

    <record id="action_pago_bancarizado_mesa_readonly" model="ir.actions.act_window">
        <field name="name">Pagos Bancarizados Mesa</field>
        <field name="res_model">casino.pago.bancarizado.mesa</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pago_bancarizado_mesa_list_readonly"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Detalles de Pagos Bancarizados Mesa.
            </p>
        </field>
    </record>
</odoo>
