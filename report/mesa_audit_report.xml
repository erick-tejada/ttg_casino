<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_mesa_audit" model="ir.actions.report">
        <field name="name">Auditoría de Mesas</field>
        <field name="model">casino.cuadre</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ttg_casino.report_mesa_audit</field>
        <field name="report_file">ttg_casino.report_mesa_audit</field>
        <field name="print_report_name">'Auditoría de Mesas %s' % object.date.strftime('%d-%m-%Y')</field>
        <field name="paperformat_id" ref="paperformat_slot_audit"/>
        <field name="binding_model_id" ref="model_casino_cuadre"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('ttg_casino.group_casino_audit'))]"/>
    </record>

    <template id="report_mesa_audit_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="doc.company_id"/>
            <t t-set="money" t-value="lambda v: 'RD$ {:,.2f}'.format(v or 0.0)"/>
            <t t-set="usd" t-value="lambda v: 'US$ {:,.2f}'.format(v or 0.0)"/>
            <t t-set="num" t-value="lambda v: '{:,.0f}'.format(v or 0)"/>
            <t t-set="estados" t-value="dict(doc._fields['mesa_estado']._description_selection(doc.env))"/>
            <div class="page o_casino_mesa_audit">
                <style>
                    .o_casino_mesa_audit { font-size: 11px; color: #222; }
                    .o_casino_mesa_audit table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
                    .o_casino_mesa_audit table.datos td, .o_casino_mesa_audit table.datos th { border: 1px solid #555; padding: 4px 6px; }
                    .o_casino_mesa_audit th { background-color: #ECEEF4; text-align: left; font-weight: bold; }
                    .o_casino_mesa_audit .amount { text-align: right; white-space: nowrap; }
                    .o_casino_mesa_audit .total td { background-color: #ECEEF4; font-weight: bold; }
                    .o_casino_mesa_audit .negative { color: #c00; }
                    .o_casino_mesa_audit .moved td { background-color: #FFF8E1; }
                    .o_casino_mesa_audit .obs { border: 1px solid #999; min-height: 40px; padding: 6px 8px; white-space: pre-wrap; }
                    .o_casino_mesa_audit .head { text-align: center; margin-bottom: 12px; }
                    .o_casino_mesa_audit .head h3 { font-size: 20px; font-weight: bold; margin: 12px 0 2px 0; }
                    .o_casino_mesa_audit h4 { font-size: 13px; font-weight: bold; margin: 10px 0 4px 0; }
                </style>

                <div class="head">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px; max-width: 220px;" alt="Logo"/>
                    <div style="margin-top: 4px;" t-out="company.name"/>
                    <div t-if="company.casino_nombre_comercial" t-out="company.casino_nombre_comercial"/>
                    <h3>CUADRE DE AUDITORÍA DE MESAS</h3>
                    <div>MESAS | <span t-out="doc.date.strftime('%d/%m/%Y')"/></div>
                </div>

                <table class="datos">
                    <tr><th style="width: 40%;">DATOS DEL REPORTE</th><th/></tr>
                    <tr><td>Fecha operativa</td><td class="amount" t-out="doc.date.strftime('%d/%m/%Y')"/></tr>
                    <tr><td>Archivo de resultados DRGT</td><td class="amount" t-out="doc.mesa_result_filename or ''"/></tr>
                    <tr><td>Archivo Chip Liability DRGT</td><td class="amount" t-out="doc.mesa_chip_filename or ''"/></tr>
                    <tr><td>Tasa USD</td><td class="amount" t-out="'{:,.2f}'.format(doc.casino_tasa_usd)"/></tr>
                </table>

                <table class="datos">
                    <tr><th style="width: 50%;">CUADRE DE MESAS (Predicted Result)</th><th class="amount">MONTO</th>
                        <th style="width: 2%; border: none; background: none;"/>
                        <th style="width: 30%;">CUADRE DE CAJA (Actual Count)</th><th class="amount">MONTO</th></tr>
                    <tr><td>Bill RD$</td><td class="amount" t-out="money(doc.mesa_pred_bill_dop)"/><td style="border: none;"/>
                        <td>Bill RD$</td><td class="amount" t-out="money(doc.mesa_act_bill_dop)"/></tr>
                    <tr><td>Amount USD (<t t-out="usd(doc.mesa_pred_usd)"/>)</td><td class="amount" t-out="money(doc.mesa_pred_usd_dop)"/><td style="border: none;"/>
                        <td>Amount USD (<t t-out="usd(doc.mesa_act_usd)"/>)</td><td class="amount" t-out="money(doc.mesa_act_usd_dop)"/></tr>
                    <tr><td>Gross Drop</td><td class="amount" t-out="money(doc.mesa_pred_gross_drop)"/><td style="border: none;"/>
                        <td>Gross Drop</td><td class="amount" t-out="money(doc.mesa_act_gross_drop)"/></tr>
                    <tr><td>(−) Net Fills</td><td class="amount" t-out="money(doc.mesa_net_fills)"/><td style="border: none;"/>
                        <td>(−) Pagos de Caja</td><td class="amount" t-out="money(doc.mesa_pagos_caja)"/></tr>
                    <tr class="total"><td>GANANCIA / PÉRDIDA MESAS</td>
                        <td t-attf-class="amount #{'negative' if doc.mesa_audit_resultado &lt; 0 else ''}" t-out="money(doc.mesa_audit_resultado)"/>
                        <td style="border: none; background: none;"/>
                        <td>GANANCIA / PÉRDIDA CAJA</td>
                        <td t-attf-class="amount #{'negative' if doc.mesa_audit_caja_resultado &lt; 0 else ''}" t-out="money(doc.mesa_audit_caja_resultado)"/></tr>
                </table>

                <table class="datos">
                    <tr><th style="width: 60%;">CONCILIACIONES</th><th class="amount">MONTO</th></tr>
                    <tr><td>Chip Liability (Net Fills − Pagos de Caja)</td><td class="amount" t-out="money(doc.mesa_chip_conciliacion)"/></tr>
                    <tr class="total"><td>VARIACIÓN (Ganancia/Pérdida Mesas − Ganancia/Pérdida Caja)</td>
                        <td t-attf-class="amount #{'negative' if doc.mesa_fuera_tolerancia else ''}" t-out="money(doc.mesa_variacion)"/></tr>
                    <tr><td>Tolerancia</td><td class="amount" t-out="money(company.casino_mesa_audit_tolerance)"/></tr>
                    <tr><td>Estado</td><td class="amount" t-out="estados.get(doc.mesa_estado, '')"/></tr>
                </table>

                <h4>RESULTADOS POR MESA</h4>
                <table class="datos">
                    <tr><th>Mesa</th><th>Juego</th><th class="amount">Net Fills</th><th class="amount">Gross Drop (Pred.)</th>
                        <th class="amount">Gross Drop (Actual)</th><th class="amount">Variación</th></tr>
                    <tr t-foreach="doc.mesa_result_ids" t-as="line">
                        <td t-out="line.mesa_id.name"/><td t-out="line.game or ''"/>
                        <td class="amount" t-out="money(line.net_fills)"/>
                        <td class="amount" t-out="money(line.pred_gross_drop)"/>
                        <td class="amount" t-out="money(line.act_gross_drop)"/>
                        <td t-attf-class="amount #{'negative' if line.variance_gross_drop else ''}" t-out="money(line.variance_gross_drop)"/>
                    </tr>
                </table>

                <t t-set="locations" t-value="[]"/>
                <t t-foreach="doc.chip_liability_ids" t-as="chip">
                    <t t-if="chip.location_code not in locations" t-set="locations" t-value="locations + [chip.location_code]"/>
                </t>
                <t t-foreach="locations" t-as="loc">
                    <t t-set="chips" t-value="doc.chip_liability_ids.filtered(lambda c: c.location_code == loc)"/>
                    <div style="page-break-inside: avoid;">
                        <h4>CHIP LIABILITY – <t t-out="'CAJA DE MESAS' if chips[0].location_type == 'cash_desk' else (chips[0].mesa_id.name or loc)"/></h4>
                        <table class="datos">
                            <tr><th>Ficha</th><th class="amount">Cant. Inicial</th><th class="amount">Monto Inicial</th>
                                <th class="amount">Cant. Mov.</th><th class="amount">Monto Mov.</th>
                                <th class="amount">Cant. Final</th><th class="amount">Monto Final</th></tr>
                            <tr t-foreach="chips" t-as="c" t-att-class="'moved' if c.move_qty else ''">
                                <td t-out="c.name"/>
                                <td class="amount" t-out="num(c.begin_qty)"/><td class="amount" t-out="money(c.begin_amount)"/>
                                <td class="amount" t-out="num(c.move_qty)"/><td class="amount" t-out="money(c.move_amount)"/>
                                <td class="amount" t-out="num(c.end_qty)"/><td class="amount" t-out="money(c.end_amount)"/>
                            </tr>
                            <tr class="total"><td>TOTAL</td>
                                <td class="amount" t-out="num(sum(chips.mapped('begin_qty')))"/><td class="amount" t-out="money(sum(chips.mapped('begin_amount')))"/>
                                <td class="amount" t-out="num(sum(chips.mapped('move_qty')))"/><td class="amount" t-out="money(sum(chips.mapped('move_amount')))"/>
                                <td class="amount" t-out="num(sum(chips.mapped('end_qty')))"/><td class="amount" t-out="money(sum(chips.mapped('end_amount')))"/></tr>
                        </table>
                    </div>
                </t>

                <h4>OBSERVACIONES</h4>
                <div class="obs" t-out="doc.mesa_observaciones or ''"/>

                <table style="margin-top: 40px;">
                    <tr>
                        <td style="width: 45%; border-top: 1px solid #222; text-align: center; padding-top: 4px;">
                            Auditor<t t-if="doc.mesa_approved_user_id">: <t t-out="doc.mesa_approved_user_id.name"/></t>
                        </td>
                        <td style="width: 10%;"/>
                        <td style="width: 45%; border-top: 1px solid #222; text-align: center; padding-top: 4px;">Revisado por</td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_mesa_audit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ttg_casino.report_mesa_audit_document"/>
            </t>
        </t>
    </template>

</odoo>
