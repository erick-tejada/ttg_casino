<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_slot_audit" model="report.paperformat">
        <field name="name">Casino - Auditoría de Contadores (Carta)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_slot_audit" model="ir.actions.report">
        <field name="name">Auditoría de Contadores</field>
        <field name="model">casino.cuadre</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ttg_casino.report_slot_audit</field>
        <field name="report_file">ttg_casino.report_slot_audit</field>
        <field name="print_report_name">'Auditoría de Contadores %s' % object.date.strftime('%d-%m-%Y')</field>
        <field name="paperformat_id" ref="paperformat_slot_audit"/>
        <field name="binding_model_id" ref="model_casino_cuadre"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('ttg_casino.group_casino_audit'))]"/>
    </record>

    <template id="report_slot_audit_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="doc.company_id"/>
            <t t-set="money" t-value="lambda v: 'RD$ {:,.2f}'.format(v or 0.0)"/>
            <t t-set="estados" t-value="dict(doc._fields['audit_estado']._description_selection(doc.env))"/>
            <div class="page o_casino_slot_audit">
                <style>
                    .o_casino_slot_audit { font-size: 12px; color: #222; }
                    .o_casino_slot_audit table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
                    .o_casino_slot_audit table.datos td, .o_casino_slot_audit table.datos th { border: 1px solid #555; padding: 6px 8px; }
                    .o_casino_slot_audit th { background-color: #ECEEF4; text-align: left; font-weight: bold; }
                    .o_casino_slot_audit .amount { text-align: right; white-space: nowrap; }
                    .o_casino_slot_audit .total td { background-color: #ECEEF4; font-weight: bold; }
                    .o_casino_slot_audit .negative { color: #c00; }
                    .o_casino_slot_audit .obs { border: 1px solid #999; min-height: 40px; padding: 6px 8px; white-space: pre-wrap; }
                    .o_casino_slot_audit .head { text-align: center; margin-bottom: 14px; }
                    .o_casino_slot_audit .head h3 { font-size: 20px; font-weight: bold; margin: 12px 0 2px 0; }
                </style>

                <div class="head">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px; max-width: 220px;" alt="Logo"/>
                    <div style="margin-top: 4px;" t-out="company.name"/>
                    <div t-if="company.casino_nombre_comercial" t-out="company.casino_nombre_comercial"/>
                    <h3>CUADRE DE AUDITORÍA DE CONTADORES</h3>
                    <div>MÁQUINAS | <span t-out="doc.date.strftime('%d/%m/%Y')"/></div>
                </div>

                <table class="datos">
                    <tr><th style="width: 40%;">DATOS DEL REPORTE</th><th/></tr>
                    <tr><td>Fecha operativa</td><td class="amount" t-out="doc.date.strftime('%d/%m/%Y')"/></tr>
                    <tr><td>Archivo DRGT</td><td class="amount" t-out="doc.slot_meter_filename or ''"/></tr>
                    <tr t-if="doc.audit_balance_filename"><td>Archivo Operation Balance</td><td class="amount" t-out="doc.audit_balance_filename"/></tr>
                    <tr><td>Importado el</td><td class="amount"><span t-field="doc.slot_meter_import_date"/></td></tr>
                    <tr><td>Importado por / Contadores</td>
                        <td class="amount"><span t-out="doc.slot_meter_import_user_id.name or ''"/> / <span t-out="doc.slot_meter_count"/></td></tr>
                </table>

                <table class="datos">
                    <tr><th>CUADRE DE CONTADORES (DOP)</th><th class="amount" style="width: 30%;">IMPORTE</th></tr>
                    <tr><td>(+) Ganancia según Contadores (NGWINE)</td><td class="amount" t-out="money(doc.audit_ngwine)"/></tr>
                    <tr><td>(+) Handpay Liability</td><td class="amount" t-out="money(doc.audit_handpay_liability)"/></tr>
                    <tr><td>(+) Sobrantes</td><td class="amount" t-out="money(doc.audit_sobrantes)"/></tr>
                    <tr><td>(-) Rifas</td><td class="amount" t-out="money(doc.audit_rifas)"/></tr>
                    <tr><td>(-) Devoluciones</td><td class="amount" t-out="money(doc.audit_devoluciones)"/></tr>
                    <tr><td>(+) Variación de Efectivo</td><td class="amount" t-out="money(doc.audit_variacion_efectivo)"/></tr>
                    <tr><td>(+) Billetes No Registrados</td><td class="amount" t-out="money(doc.audit_billetes_no_registrados)"/></tr>
                    <tr><td>(+) Crédito en Máquina (CRE)</td><td class="amount" t-out="money(doc.audit_credito_maquina)"/></tr>
                    <tr class="total"><td>Resultado según Contadores</td><td class="amount" t-out="money(doc.audit_resultado)"/></tr>
                </table>

                <table class="datos">
                    <tr><th>COMPARACIÓN CON CAJA MÁQUINAS</th><th class="amount" style="width: 30%;">IMPORTE</th></tr>
                    <tr><td>Resultado según Contadores</td><td class="amount" t-out="money(doc.audit_resultado)"/></tr>
                    <tr><td>Resultado Caja Máquinas (Cuadre del Día)</td><td class="amount" t-out="money(doc.resultado_caja_maquina)"/></tr>
                    <tr class="total"><td>Diferencia (Contadores - Caja)</td>
                        <td t-attf-class="amount {{ 'negative' if doc.audit_fuera_tolerancia else '' }}" t-out="money(doc.audit_diferencia)"/></tr>
                </table>

                <table class="datos" t-if="doc.audit_cash_file">
                    <tr><th>RIFAS Y DEVOLUCIONES (CUADRE vs DRGT)</th><th class="amount" style="width: 20%;">CUADRE</th>
                        <th class="amount" style="width: 20%;">DRGT</th><th class="amount" style="width: 20%;">DIFERENCIA</th></tr>
                    <tr><td>Rifas</td><td class="amount" t-out="money(doc.premios_maquina_total)"/>
                        <td class="amount" t-out="money(doc.audit_drgt_rifas)"/>
                        <td t-attf-class="amount {{ 'negative' if doc.audit_dif_rifas else '' }}" t-out="money(doc.audit_dif_rifas)"/></tr>
                    <tr><td>Devoluciones</td><td class="amount" t-out="money(doc.devolucion_total)"/>
                        <td class="amount" t-out="money(doc.audit_drgt_devoluciones)"/>
                        <td t-attf-class="amount {{ 'negative' if doc.audit_dif_devoluciones else '' }}" t-out="money(doc.audit_dif_devoluciones)"/></tr>
                </table>

                <div>
                    <strong>Estado de conciliación:</strong>
                    <span t-out="estados.get(doc.audit_estado, '')"/>
                    <span style="color: #666;">(tolerancia <t t-out="money(company.casino_slot_audit_tolerance)"/>)</span>
                    <span t-if="doc.audit_cash_mismatch" class="negative"> · Rifas/Devoluciones no coinciden con DRGT.</span>
                </div>
                <div style="margin-bottom: 4px;">
                    <strong>Auditoría:</strong>
                    <t t-if="doc.audit_approved">aprobada el <span t-field="doc.audit_approved_date"/> por <span t-out="doc.audit_approved_user_id.name"/>.</t>
                    <t t-else="">pendiente de aprobación.</t>
                </div>
                <div><strong>Observaciones de auditoría:</strong></div>
                <div class="obs" t-out="doc.audit_justificacion or ''"/>

                <div style="margin-top: 60px; page-break-inside: avoid; overflow: hidden;">
                    <div style="float: left; width: 40%; margin-left: 5%; border-top: 1px solid #333; padding-top: 4px; text-align: center;">
                        AUDITADO POR / OPERACIONES
                        <div t-if="doc.audit_approved_user_id" style="color: #666;" t-out="doc.audit_approved_user_id.name"/>
                    </div>
                    <div style="float: right; width: 40%; margin-right: 5%; border-top: 1px solid #333; padding-top: 4px; text-align: center;">
                        REVISADO POR / CONTABILIDAD
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_slot_audit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ttg_casino.report_slot_audit_document"/>
            </t>
        </t>
    </template>

</odoo>
